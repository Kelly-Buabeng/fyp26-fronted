# Server-only configuration. Never prefix secrets with NEXT_PUBLIC_.
BACKEND_API_URL=http://127.0.0.1:8000
BACKEND_API_KEY=
# Required for authority personnel access.
ADMIN_EMAIL=authority@rha.com
ADMIN_PASSWORD=
SESSION_SECRET=
# Exact public frontend origin; required in production (HTTPS).
APP_ORIGIN=http://localhost:3000
BACKEND_TIMEOUT_MS=120000
# Single-instance in-memory limiter. Use trusted ingress rate limits for multi-instance deployments.
# Enable only if your reverse proxy overwrites X-Forwarded-For.
TRUST_PROXY=false
